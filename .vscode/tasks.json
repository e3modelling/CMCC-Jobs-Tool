{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run OPEN-PROM Energy Jobs",
      "type": "process",
      "command": "C:\\Program Files\\R\\R-4.6.0\\bin\\x64\\Rscript.exe",
      "args": [
        "${workspaceFolder}/run_openprom_jobs.R",
        "${input:openpromRunFolder}",
        "--visualize=${input:visualizationMode}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Compare OPEN-PROM Scenarios",
      "type": "process",
      "command": "C:\\Program Files\\R\\R-4.6.0\\bin\\x64\\Rscript.exe",
      "args": [
        "${workspaceFolder}/compare_openprom_scenarios.R",
        "${workspaceFolder}/energy_jobs_results",
        "--interactive"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "openpromRunFolder",
      "type": "promptString",
      "description": "OPEN-PROM run folder path",
      "default": "C:\\Users\\sonja\\CMCC-Jobs-Tool\\OPENPROM_run_DAILY_1p5C_2026-08-26"
    },
    {
      "id": "visualizationMode",
      "type": "pickString",
      "description": "Visualization mode",
      "options": [
        "none",
        "total",
        "breakdown",
        "all"
      ],
      "default": "all"
    }
  ]
}
